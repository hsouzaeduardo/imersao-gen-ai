# ---------------------------------------------------------------
# Modelo: Azure OpenAI direto (caminho curto, recomendado na aula)
# ---------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://ari-aurora-aoai.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini
# Com Entra ID (recomendado) deixe a chave vazia e faça `az login`.
AZURE_OPENAI_API_KEY=

# ---------------------------------------------------------------
# Modelo via Azure AI Foundry Agent Service (agentes do lado do serviço)
# ---------------------------------------------------------------
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Qual cliente os labs usam: "aoai" ou "foundry"
ARI_CLIENT=foundry

# ---------------------------------------------------------------
# Lab 02: memória
# ---------------------------------------------------------------
REDIS_URL=rediss://ari-aurora-redis.brazilsouth.redis.azure.net:10000
REDIS_PASSWORD=

# ---------------------------------------------------------------
# Lab 03: API de rede da Aurora (Container Apps ou localhost)
# ---------------------------------------------------------------
AURORA_API_URL=http://localhost:8000

# ---------------------------------------------------------------
# Lab 04: MCP Toolbox for Databases (Container Apps ou localhost)
# ---------------------------------------------------------------
TOOLBOX_MCP_URL=http://localhost:5000/mcp

# ---------------------------------------------------------------
# Banco da Aurora: credenciais do Postgres.
#
# Quem lê estas variáveis é o MCP Toolbox, não o agente.
# O tools.yaml as interpola em `sources.aurora-postgres`, e é por isso
# que o agente nunca vê a senha do banco: ele só conhece TOOLBOX_MCP_URL.
# Esse é o ponto do lab 04, então não mova estas linhas para o código.
#
# Só preencha se o Toolbox for rodar apontando para o Azure, via
# `docker compose -f docker-compose.azure-db.yml up -d`.
# O Plano B (docker-compose.local.yml) ignora este bloco de propósito:
# ele sobe o próprio Postgres com valores fixos, para não quebrar
# em sala caso o .env esteja apontando para a nuvem.
# ---------------------------------------------------------------
POSTGRES_HOST=<seu-servidor>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=aurora_fibra
POSTGRES_USER=<usuario-admin>
POSTGRES_PASSWORD=

# ---------------------------------------------------------------
# Habbo: visualização ao vivo dos agentes (opcional)
# github.com/hsouzaeduardo/habbo-agents
# Sem HABBO_URL, tudo vira no-op e nenhum lab muda de comportamento.
# ---------------------------------------------------------------
HABBO_URL=https://<sua-instancia>.azurewebsites.net
HABBO_API_KEY=

# ---------------------------------------------------------------
# Observabilidade
# ---------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
ENABLE_OTEL=false
